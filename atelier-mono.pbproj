 LOGIC","license":"cc0","provider":"flickr","source":"openverse"}},"title":"제작 과정","sub":"스케치를 그리고 실물 크기 목업을 만든 다음 양산합니다","cta":"겨울 작업","href":"겨울에는 난로를 켜 두고 접착 작업을 합니다"},{"image":{"id":"imgmsbj6mvln","alt":"작업대 위에 놓인 오래된 목공 도구","fit":"cover","w":1024,"h":576,"bytes":173456,"credit":{"title":"Old traditional carpenters tools retro vintage style","creator":"ky0nch3ng","license":"cc0","provider":"flickr","source":"openverse"}},"title":"납품","sub":"포장과 배송도 직접 합니다","cta":"","href":""},{"image":{"id":"imgmsbj6zz7o","alt":"MCLI Server 'Farm'","fit":"cover","w":768,"h":1024,"bytes":71506,"credit":{"title":"MCLI Server 'Farm'","creator":"cogdogblog","license":"cc0","provider":"flickr","source":"openverse"}},"title":"포장을 마친 가구","sub":"","cta":"","href":""}],"transition":"밀기","height":400,"overlay":0.42,"align":"center","valign":"center","autoplay":true,"interval":5,"speed":600,"pauseOnHover":true,"loop":true,"dots":true,"arrows":true,"kenBurns":false},"x2-1":{"title":"제작 문의","sub":"원하는 치수와 쓰임을 알려 주시면 도면부터 함께 정합니다.","cta":"제작 문의","ctaHref":"","ctaFile":null,"ctaKind":"채움","ctaBg":"","ctaText":"","ctaRadius":10,"ctaScale":1.15,"align":"center","gradient":true}},"fx":{"x2-1":[{"name":"magnetic","options":{"strength":0.35,"radius":110,"labelFactor":0.5,"scale":1.04,"rotate":6,"speed":11,"glow":true}}],"c":[{"name":"reveal","options":{"preset":"rise","duration":650,"delay":0,"distance":22,"rotate":0,"scale":1,"threshold":0.2,"repeat":false}}]}},{"id":"p9ae","name":"About","wireframe":"stack","fills":{"a":"topheader","b":"section","c":"section","d":"footer","x1-1":"marquee","x2-1":"cover"},"extra":[{"id":"x1","cols":1,"at":3},{"id":"x2","cols":1,"at":3}],"overrides":{},"content":{"a":{"logo":"Atelier Mono","align":"space-between","showMenu":true,"linkTo":"페이지","sticky":true,"divider":true,"modeToggle":false,"hideOnScroll":false},"b":{"title":"소개","body":"Atelier Mono는 2019년 서울 연희동 반지하 작업실에서 시작한 1인 공방입니다.\n의자 하나를 반년 넘게 만드는 일이 많아서 한 해에 내놓는 종류는 적습니다. 고쳐 쓸 수 있도록 도면과 부품 목록을 함께 드립니다.\n20